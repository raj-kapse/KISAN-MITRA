# ============================================
# Kisan Mitra — Backend Environment Variables
# ============================================
# Copy this to .env and fill in real values.
# NEVER commit the actual .env file.

# --- Groq (primary for text chat + advisory; vision fallback) ---
# Free key: https://console.groq.com (no card needed).
# Qwen 3.8-27b is multimodal — it reads leaf images and returns the
# diagnosis JSON. Change GROQ_MODEL only if you know why.
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=qwen/qwen3.8-27b

# --- Gemini (primary for vision diagnosis; text fallback) ---
# Free key: https://aistudio.google.com/apikey
# Models are tried in order; each has its own free-tier daily quota.
GEMINI_API_KEY=your_gemini_api_key_here
DIAGNOSIS_PROVIDER_ORDER=gemini,groq
GEMINI_VISION_MODEL_1=gemini-3.6-flash
GEMINI_VISION_MODEL_2=gemini-3.5-flash-lite
GEMINI_VISION_MODEL_3=gemini-3.5-flash

# --- OpenWeatherMap (weather advisory + geocoding) ---
# Free key: https://openweathermap.org/api (new keys activate in ~10min-2h)
OPENWEATHER_API_KEY=your_openweathermap_api_key_here

# --- Firebase (scan history / auth) ---
# Path to the Firebase service account JSON file
FIREBASE_SERVICE_ACCOUNT_PATH=./firebase-service-account.json
FIREBASE_PROJECT_ID=your_firebase_project_id_here

# --- Server ---
PORT=5000
NODE_ENV=development

# --- CORS ---
FRONTEND_URL=http://localhost:5173
